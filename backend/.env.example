# ============================================
# Trading Dashboard Backend — Multi-Pair Config
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS — Your Netlify frontend URL
ALLOWED_ORIGIN=https://your-site.netlify.app

# Twelve Data API Key (get free key at https://twelvedata.com/)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Watchlist — 5 pairs monitored simultaneously
WATCHLIST=XAU/USD,USD/JPY,GBP/JPY,EUR/USD,BTC/USD

# Default timeframe for all pairs
DEFAULT_TIMEFRAME=1h
POLL_INTERVAL_SECONDS=60

# Risk Management (Golden Rules from YouTube Strategy)
MAX_RISK_PER_TRADE_PCT=2.0
DEFAULT_STOP_LOSS_PCT=1.5
DEFAULT_TAKE_PROFIT_PCT=3.0
MAX_POSITIONS=3

# Strategy Parameters
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VOLUME_MA_PERIOD=20
