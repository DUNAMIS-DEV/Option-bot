# ============================================
# Trading Dashboard Backend — Multi-Pair Config
# ============================================

PORT=3000
NODE_ENV=production

# Twelve Data API Key (get free key at https://twelvedata.com/)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Watchlist — 5 pairs monitored simultaneously
# Changed BTC/USD to GBP/USD
WATCHLIST=XAU/USD,USD/JPY,GBP/JPY,EUR/USD,GBP/USD

DEFAULT_TIMEFRAME=1h
POLL_INTERVAL_SECONDS=60

# Risk Management
MAX_RISK_PER_TRADE_PCT=2.0
DEFAULT_STOP_LOSS_PCT=1.5
DEFAULT_TAKE_PROFIT_PCT=3.0
MAX_POSITIONS=3

# Strategy Parameters
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VOLUME_MA_PERIOD=20
